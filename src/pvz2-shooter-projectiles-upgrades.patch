+    public int getPlantFoodShotCount() {
+        return plantFoodShotCount;
+    }
+
+    public int getPlantFoodDamageMultiplier() {
+        return plantFoodDamageMultiplier;
+    }
+
+    private enum UpgradeValue {
+        HIT_POINTS,
+        DAMAGE,
+        COST
+    }
+}
