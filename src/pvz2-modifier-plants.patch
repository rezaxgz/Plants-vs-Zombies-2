+            if (plant instanceof Modifier && ((Modifier) plant).isTorchwood()
+                    && !plant.isRemoved()) {
+                torchwoods.add((Modifier) plant);
+            }
+        }
+        if (torchwoods.isEmpty()) {
+            return;
+        }
+        for (Entity entity : updateSnapshot) {
+            if (!(entity instanceof Projectile) || entity.isRemoved()) {
+                continue;
